[
  {
    "battery": {
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-icons": [
        "󰁺",
        "󰁻",
        "󰁽",
        "󰁿",
        "󰂁",
        "󰁹"
      ],
      "states": {
        "critical": 15,
        "warning": 30
      }
    },
    "clock": {
      "format": "  {:%a %d %b  %H:%M}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
      "format": "  {usage}%",
      "interval": 5
    },
    "height": 22,
    "hyprland/window": {
      "max-length": 60,
      "separate-outputs": true
    },
    "hyprland/workspaces": {
      "all-outputs": true,
      "disable-scroll": true,
      "format": "{icon}",
      "format-icons": {
        "active": "",
        "default": "",
        "urgent": ""
      }
    },
    "layer": "top",
    "memory": {
      "format": "  {}%"
    },
    "modules-center": [
      "clock"
    ],
    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "custom/power": {
      "format": "⏻",
      "on-click": "$HOME/.config/waybar/scripts/power-menu.sh",
      "tooltip": false
    },
    "custom/screenshot": {
      "format": "󰄀",
      "on-click": "$HOME/.config/waybar/scripts/screenshot.sh",
      "tooltip-format": "Screenshot (drag the result into any app)"
    },
    "custom/record": {
      "exec": "$HOME/.config/waybar/scripts/record-status.sh",
      "on-click": "$HOME/.config/waybar/scripts/record-toggle.sh",
      "return-type": "json",
      "signal": 9,
      "tooltip": true
    },
    "custom/bluelight": {
      "exec": "$HOME/.config/waybar/scripts/bluelight-status.sh",
      "on-click": "$HOME/.config/waybar/scripts/bluelight-toggle.sh",
      "on-scroll-up": "$HOME/.config/waybar/scripts/bluelight-adjust.sh 1",
      "on-scroll-down": "$HOME/.config/waybar/scripts/bluelight-adjust.sh -1",
      "return-type": "json",
      "signal": 8,
      "tooltip": true
    },
    "modules-right": [
      "tray",
      "network",
      "pulseaudio",
      "cpu",
      "memory",
      "battery",
      "custom/screenshot",
      "custom/record",
      "custom/bluelight",
      "custom/power"
    ],
    "network": {
      "format-disconnected": "󰖪  offline",
      "format-ethernet": "󰈀  {ifname}",
      "format-wifi": "  {essid}",
      "tooltip-format": "{ifname}: {ipaddr}"
    },
    "position": "top",
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-icons": {
        "default": [
          "",
          "",
          ""
        ]
      },
      "format-muted": "󰝟 muted",
      "on-click": "pamixer --toggle-mute"
    },
    "spacing": 2,
    "tray": {
      "spacing": 2
    }
  }
]
