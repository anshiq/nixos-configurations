async-backend = epoll
background = #1e1512
confirm-close-surface = false
cursor-color = #ffb37a
cursor-style = block
cursor-style-blink = false
font-family = JetBrainsMono Nerd Font
font-size = 10
font-style = Regular
foreground = #e0c2a8
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+enter=csi:13;2u
mouse-scroll-multiplier = 0.950000
palette = 0=#1e1512
palette = 1=#f7768e
palette = 2=#b9ca6a
palette = 3=#e0af68
palette = 4=#e8935c
palette = 5=#dba463
palette = 6=#ffb37a
palette = 7=#e0c2a8
palette = 8=#4a3728
palette = 9=#ff9e8e
palette = 10=#d9c98a
palette = 11=#ffcf8c
palette = 12=#ffab73
palette = 13=#f0b98a
palette = 14=#ffd1a3
palette = 15=#f5e3d0
resize-overlay = never
selection-background = #33241c
selection-foreground = #ffe1c2
shell-integration-features = no-cursor,ssh-env
window-padding-x = 14
window-padding-y = 14
window-theme = ghostty
